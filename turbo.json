{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["NODE_ENV"]
    }
  },
  "pipeline": {
    "build": {
      "filter": "!@qr-menu/documentation"
    },
    "dev": {
      "filter": "!@qr-menu/documentation"
    }
  }
}
