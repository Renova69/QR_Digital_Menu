generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                            String                  @id @default(cuid())
  email                         String                  @unique
  password                      String
  name                          String?
  phone                         String?
  googleId                      String?                 @unique
  pinHash                       String?
  pinAttempts                   Int                     @default(0)
  pinLockedUntil                DateTime?
  isActive                      Boolean                 @default(true)
  disabledAt                    DateTime?
  disabledReason                String?
  passwordChangedAt             DateTime?
  role                          UserRole                @default(STAFF)
  restaurantId                  String?
  lastLoginDeviceTokenId        String?
  onboardingComplete            Boolean                 @default(false)
  onboardingStep                String?
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt
  orders                        Order[]
  staffOrders                   Order[]                 @relation("StaffOrders")
  createdDeviceEnrollmentTokens DeviceEnrollmentToken[]
  staffDeviceBindings           StaffDeviceBinding[]
  lastLoginDeviceToken          DeviceEnrollmentToken?   @relation("LastStaffDeviceLogin", fields: [lastLoginDeviceTokenId], references: [id], onDelete: SetNull)
  loyaltyAccounts               LoyaltyAccount[]
  restaurants                   Restaurant[]            @relation("OwnedRestaurants")
  staffRestaurant               Restaurant?             @relation("StaffRestaurant", fields: [restaurantId], references: [id])
  adminAuditLogs                AdminAuditLog[]
  cashPaymentRequestsResolved   CashPaymentRequest[]    @relation("CashPaymentRequestResolvedBy")
  impersonationSessionsAsActor  ImpersonationSession[]  @relation("ImpersonationActor")
  impersonationSessionsAsTarget ImpersonationSession[]  @relation("ImpersonationTarget")
  dataRequests                  DataRequest[]           @relation("DataRequestUser")
  processedDataRequests         DataRequest[]           @relation("DataRequestProcessor")

  @@map("app_user")
}

model Restaurant {
  id                        String                  @id @default(cuid())
  name                      String
  country                   String                  @default("Bulgaria")
  city                      String?
  logoUrl                   String?
  logoThumbnailUrl          String?
  accentColor               String?                 @default("#4F46E5")
  googleReviewUrl           String?
  facebookUrl               String?
  instagramUrl              String?
  tiktokUrl                 String?
  websiteUrl                String?
  youtubeUrl                String?
  address                   String?
  contactInfo               String?
  targetLanguages           String[]                @default([])
  dashboardLanguage         String?                 @default("en")
  timezone                  String?                 @default("Europe/Sofia")
  ownerId                   String
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  fontBody                  String?                 @default("Outfit")
  fontHeading               String?                 @default("Playfair Display")
  themeBgColor              String?
  themeCardColor            String?
  themeTextColor            String?
  themeLightBgColor         String?
  themeLightTextColor       String?
  themeLightCardColor       String?
  themeLightAccentColor     String?
  themeDarkBgColor          String?
  themeDarkTextColor        String?
  themeDarkCardColor        String?
  themeDarkAccentColor      String?
  trendingMode              String                  @default("AUTO")
  happyHourEnable           Boolean                 @default(false)
  happyHourDays             Int[]                   @default([1, 2, 3, 4, 5, 6, 7])
  happyHourEndTime          String?
  happyHourMultiplier       Float                   @default(2.0)
  happyHourStartTime        String?
  isLoyaltyEnabled          Boolean                 @default(true)
  loyaltyExchangeRate       Int                     @default(10)
  loyaltySignupBonus        Int                     @default(50)
  loyaltyRedeemRate         Int                     @default(150)
  loyaltyExpiryReminderDays Int                     @default(15)
  loyaltyGoldMultiplier     Float                   @default(1.5)
  loyaltyGoldThreshold      Int                     @default(2000)
  loyaltyPointExpiryDays    Int                     @default(90)
  loyaltySilverMultiplier   Float                   @default(1.2)
  loyaltySilverThreshold    Int                     @default(500)
  defaultTheme              String?                 @default("light")
  importApiKeyHash          String?                 @unique
  stripeAccountId           String?
  stripeOnboarded           Boolean                 @default(false)
  paymentsEnabled           Boolean                 @default(false)
  epayEnabled               Boolean                 @default(false)
  epayMode                  String                  @default("DEMO")
  epayClientId              String?
  epayMerchantEmail         String?
  epaySecretEncrypted       String?
  epayPage                  String                  @default("credit_paydirect")
  boricaEnabled             Boolean                 @default(false)
  boricaMode                String                  @default("DEMO")
  boricaTerminalId          String?
  boricaMerchantId          String?
  boricaMerchantName        String?
  boricaPrivateKeyEncrypted String?
  boricaPublicCert          String?
  boricaCurrency            String                  @default("EUR")
  myposEnabled              Boolean                 @default(false)
  myposMode                 String                  @default("DEMO")
  myposClientNumber         String?
  myposStoreId              String?
  myposKeyIndex             String?
  myposPrivateKeyEncrypted  String?
  myposPublicCert           String?
  myposCurrency             String                  @default("EUR")
  sharedDeviceModeEnabled   Boolean                 @default(false)
  notifyAllStaffOnPayment   Boolean                 @default(true)
  tipsEnabled               Boolean                 @default(false)
  tipOptions                Int[]                   @default([2, 4, 5])
  platformFeePercent        Float                   @default(0.5)
  tier                      SubscriptionTier        @default(FREE)
  stripeCustomerId          String?
  stripeSubscriptionId      String?
  stripePriceId             String?
  tierUpdatedAt             DateTime?
  pastDueGraceExpiry        DateTime?
  forceTier                 SubscriptionTier?
  forceTierExpiresAt        DateTime?
  isActive                  Boolean                 @default(true)
  deletedAt                 DateTime?
  assistanceRequests        AssistanceRequest[]
  cashPaymentRequests       CashPaymentRequest[]
  deviceEnrollmentTokens    DeviceEnrollmentToken[]
  staffDeviceBindings       StaffDeviceBinding[]
  orders                    Order[]
  feedbacks                 Feedback[]
  loyaltyAccounts           LoyaltyAccount[]
  menuCategories            MenuCategory[]
  menuViews                 MenuView[]
  owner                     User                    @relation("OwnedRestaurants", fields: [ownerId], references: [id], onDelete: Cascade)
  staffMembers              User[]                  @relation("StaffRestaurant")
  tables                    RestaurantTable[]
  tableSessions             TableSession[]
  tableZones                TableZone[]
  payments                  Payment[]
  paymentProviderEvents     PaymentProviderEvent[]
  printStations             PrintStation[]
  printAgentTokens          PrintAgentToken[]
  printJobs                 PrintJob[]
  dailyTargets              DailyTarget[]
  reservations              Reservation[]
  reservationSettings       ReservationSettings?
  reservationServiceHours   ReservationServiceHours[]
  reservationBlackouts      ReservationBlackout[]
  patrons                   Patron[]

  @@index([stripeCustomerId])
  @@index([pastDueGraceExpiry])
  @@index([forceTierExpiresAt])
  @@map("restaurant")
}

model MenuView {
  id           String     @id @default(cuid())
  restaurantId String
  tableId      String?
  tableName    String?
  visitorId    String?
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@index([restaurantId, tableId, createdAt])
  @@index([restaurantId, visitorId, createdAt])
  @@map("menu_view")
}

model TableZone {
  id           String            @id @default(cuid())
  name         String
  restaurantId String
  displayOrder Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables       RestaurantTable[]

  @@unique([restaurantId, name])
  @@index([restaurantId, displayOrder])
  @@map("table_zone")
}

model PrintStation {
  id               String            @id @default(cuid())
  restaurantId     String
  name             String
  printerIp        String
  printerPort      Int               @default(9100)
  isActive         Boolean           @default(true)
  receiptTemplate  Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  restaurant       Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categories       MenuCategory[]
  agentTokens      PrintAgentToken[]
  printJobs        PrintJob[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("print_station")
}

model PrintAgentToken {
  id             String       @id @default(cuid())
  token          String?      @unique
  tokenHash      String       @unique
  printStationId String
  restaurantId   String
  label          String?
  lastSeenAt     DateTime?
  createdAt      DateTime     @default(now())
  printStation   PrintStation @relation(fields: [printStationId], references: [id], onDelete: Cascade)
  restaurant     Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("print_agent_token")
}

model PrintJob {
  id             String         @id @default(cuid())
  restaurantId   String
  printStationId String?
  orderId        String
  ticketBase64   String
  status         PrintJobStatus @default(PENDING)
  attempts       Int            @default(0)
  errorMessage   String?
  lastAttemptAt  DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  restaurant     Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  printStation   PrintStation?  @relation(fields: [printStationId], references: [id], onDelete: SetNull)
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([printStationId, status])
  @@index([restaurantId, status])
  @@index([status, createdAt])
  @@map("print_job")
}

model RestaurantTable {
  id           String         @id @default(cuid())
  name         String
  restaurantId String
  zoneId       String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  zone         TableZone?     @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  sessions     TableSession[]
  cashPaymentRequests CashPaymentRequest[]

  @@unique([restaurantId, name])
  @@index([restaurantId, zoneId])
  @@map("restaurant_table")
}

model MenuCategory {
  id               String           @id @default(cuid())
  name             String
  restaurantId     String
  order            Int
  availabilityType AvailabilityType @default(ALWAYS)
  startTime        String?
  endTime          String?
  daysOfWeek       Int[]
  translations     Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  imageUrl         String?
  thumbnailUrl     String?
  isDrinkCategory  Boolean          @default(false)
  printStationId   String?
  printStation     PrintStation?    @relation(fields: [printStationId], references: [id], onDelete: SetNull)
  restaurant       Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items            MenuItem[]

  @@index([restaurantId])
  @@map("menu_category")
}

model MenuItem {
  id                String       @id @default(cuid())
  name              String
  description       String?
  price             Float
  costPrice         Float?      @default(0)
  weight            String?
  currency          Currency
  allergens         String[]
  dietaryTags       String[]
  imageUrl          String?
  thumbnailUrl      String?
  isOutOfStock      Boolean      @default(false)
  categoryId        String
  order             Int
  translations      Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  isFeatured        Boolean      @default(false)
  relatedItemIds    String[]     @default([])
  rewardPointsPrice Int?
  category          MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options           MenuOption[]
  orderItems        OrderItem[]

  @@index([categoryId, order])
  @@map("menu_item")
}

model MenuOption {
  id           String     @id @default(cuid())
  name         String
  type         OptionType
  choices      Json
  menuItemId   String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  translations Json?
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@map("menu_option")
}

model Order {
  id                        String               @id @default(cuid())
  customerName              String
  customerPhone             String?
  tableId                   String?
  tableName                 String?
  status                    OrderStatus          @default(NEW)
  restaurantId              String
  totalPrice                Float
  specialRequests           String?
  tableSessionId            String?
  tableSession              TableSession?        @relation(fields: [tableSessionId], references: [id])
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  customerId                String?
  pointsEarned              Int                  @default(0)
  pointsRedeemed            Int                  @default(0)
  pointsRedeemedForDiscount Int                  @default(0)
  pointsRedeemedForItems    Int                  @default(0)
  customer                  User?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  restaurant                Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  feedback                  Feedback?
  loyaltyPointTransactions  LoyaltyPointLedger[]
  items                     OrderItem[]
  source                    OrderSource          @default(CUSTOMER)
  staffUserId               String?
  staff                     User?                @relation("StaffOrders", fields: [staffUserId], references: [id], onDelete: SetNull)
  printJobs                 PrintJob[]

  @@index([restaurantId, status, createdAt])
  @@index([customerId])
  @@index([staffUserId])
  @@index([tableSessionId])
  @@map("customer_order")
}

model OrderItem {
  id              String              @id @default(cuid())
  orderId         String
  menuItemId      String?
  quantity        Int
  unitPrice       Float               @default(0)
  unitPriceWithOptions Float          @default(0)
  // Units of this line already settled by a split payment. Split-bill remaining
  // is computed from (quantity - paidQuantity); see PaymentService.settlePartial.
  paidQuantity    Int                 @default(0)
  selectedOptions Json
  notes           String?             @db.VarChar(500)
  menuItem        MenuItem?           @relation(fields: [menuItemId], references: [id])
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  allocations     PaymentAllocation[]

  @@index([orderId])
  @@map("order_item")
}

// Records exactly which order-item units a by-item split payment covered.
// Enables hiding paid units in the picker, itemized per-payer receipts, and
// reversing paidQuantity on refund. Even/custom split payments create no rows
// here — they only reduce the session's amount-based remaining balance.
model PaymentAllocation {
  id          String    @id @default(cuid())
  paymentId   String
  orderItemId String
  quantity    Int
  amount      Float
  createdAt   DateTime  @default(now())
  payment     Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([paymentId, orderItemId])
  @@index([paymentId])
  @@index([orderItemId])
  @@map("payment_allocation")
}

model AssistanceRequest {
  id           String     @id @default(cuid())
  tableId      String
  isResolved   Boolean    @default(false)
  restaurantId String
  type         String     @default("STANDARD")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, isResolved])
  @@map("assistance_request")
}

model CashPaymentRequest {
  id             String                   @id @default(cuid())
  restaurantId   String
  tableSessionId String
  tableId        String
  status         CashPaymentRequestStatus @default(PENDING)
  scope          CashPaymentRequestScope  @default(FULL_TABLE)
  scopeKey       String
  orderIds       String[]                 @default([])
  requestedAmount Float
  currency       String                   @default("EUR")
  paymentId      String?                  @unique
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  restaurant     Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableSession   TableSession             @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  table          RestaurantTable          @relation(fields: [tableId], references: [id], onDelete: Cascade)
  payment        Payment?                 @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  resolvedBy     User?                    @relation("CashPaymentRequestResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([restaurantId, status, createdAt])
  @@index([tableSessionId, status])
  @@index([tableId, status])
  @@index([resolvedById])
  @@map("cash_payment_request")
}

model DeviceEnrollmentToken {
  id             String     @id @default(cuid())
  tokenHash      String     @unique
  restaurantId   String
  createdById    String
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  sessionVersion Int        @default(0)
  pinAttempts    Int        @default(0)
  pinLockedUntil DateTime?
  createdAt      DateTime   @default(now())
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdBy      User       @relation(fields: [createdById], references: [id], onDelete: Cascade)
  staffBindings  StaffDeviceBinding[]
  lastLoginUsers User[]     @relation("LastStaffDeviceLogin")

  @@index([restaurantId])
  @@index([expiresAt])
  @@map("device_enrollment_token")
}

model StaffDeviceBinding {
  id            String                @id @default(cuid())
  userId        String
  deviceTokenId String
  restaurantId  String
  firstSeenAt   DateTime              @default(now())
  lastSeenAt    DateTime              @default(now())
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceToken   DeviceEnrollmentToken @relation(fields: [deviceTokenId], references: [id], onDelete: Cascade)
  restaurant    Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceTokenId])
  @@index([restaurantId, userId])
  @@index([deviceTokenId])
  @@map("staff_device_binding")
}

model StaffPinLoginAudit {
  id            String   @id @default(cuid())
  userId        String?
  deviceTokenId String
  restaurantId  String
  status        String
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([userId, createdAt])
  @@index([deviceTokenId, createdAt])
  @@map("staff_pin_login_audit")
}

model Feedback {
  id                 String     @id @default(cuid())
  rating             Int
  comment            String?
  redirectedToGoogle Boolean    @default(false)
  orderId            String     @unique
  restaurantId       String
  createdAt          DateTime   @default(now())
  order              Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("feedback")
}

model LoyaltyAccount {
  id             String               @id @default(cuid())
  userId         String
  restaurantId   String
  points         Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  lifetimePoints Int                  @default(0)
  restaurant     Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointLedger    LoyaltyPointLedger[]

  @@unique([userId, restaurantId])
  @@map("loyalty_account")
}

model LoyaltyPointLedger {
  id               String                      @id @default(cuid())
  loyaltyAccountId String
  orderId          String?
  type             LoyaltyPointTransactionType
  points           Int
  remainingPoints  Int                         @default(0)
  expiresAt        DateTime?
  reminderSentAt   DateTime?
  createdAt        DateTime                    @default(now())
  loyaltyAccount   LoyaltyAccount              @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  // #21: SetNull (not the default RESTRICT) so deleting an order — or a
  // restaurant that cascade-deletes its orders — never fails on a referencing
  // ledger row. orderId is already nullable; the ledger is retained as an audit
  // trail with a null orderId rather than blocking the delete.
  order            Order?                      @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([loyaltyAccountId, expiresAt])
  @@index([expiresAt, reminderSentAt])
  @@map("loyalty_point_ledger")
}

enum UserRole {
  OWNER
  MANAGER
  WAITER
  KITCHEN
  STAFF
  CUSTOMER
  SUPER_ADMIN
}

enum Currency {
  EUR
  BGN
}

enum OrderStatus {
  NEW
  IN_PROGRESS
  SERVED
  CANCELED
  COMPLETED
  PENDING_PAYMENT
}

enum OrderSource {
  CUSTOMER
  POS
}

enum OptionType {
  VARIATION
  ADDON
}

enum AvailabilityType {
  ALWAYS
  SCHEDULED
  HIDDEN
}

enum LoyaltyPointTransactionType {
  EARN
  SIGNUP
  REDEEM
  EXPIRE
  ADJUSTMENT
}

model VerificationToken {
  id          String    @id @default(cuid())
  email       String
  code        String
  expiresAt   DateTime
  usedAt      DateTime?
  attempts    Int       @default(0)
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

model TableSession {
  id           String             @id @default(cuid())
  token        String             @unique @default(cuid())
  tableId      String
  restaurantId String
  status       TableSessionStatus @default(OPEN)
  createdAt    DateTime           @default(now())
  paidAt       DateTime?
  orders       Order[]
  payments     Payment[]
  cashPaymentRequests CashPaymentRequest[]
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table        RestaurantTable    @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([tableId, status])
  @@index([restaurantId, status])
  @@map("table_session")
}

model Payment {
  id                    String          @id @default(cuid())
  tableSessionId        String
  restaurantId          String
  stripePaymentIntentId String?         @unique
  providerReference     String?         @unique
  providerStatus        String?
  providerPayload       Json?
  amount                Float
  tipAmount             Float           @default(0)
  platformFeeAmount     Float           @default(0)
  currency              String          @default("EUR")
  status                PaymentStatus   @default(PENDING)
  provider              PaymentProvider @default(STRIPE)
  // Marks how a partial/split payment was settled (ITEM/EVEN/CUSTOM). Null for a
  // full-bill payment. Reporting/audit only — the PAID gate is amount-based.
  splitMode             String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  tableSession          TableSession        @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  restaurant            Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  allocations           PaymentAllocation[]
  providerEvents        PaymentProviderEvent[]
  refundAttempts        RefundAttempt[]
  cashPaymentRequest    CashPaymentRequest?

  @@index([tableSessionId])
  @@index([restaurantId])
  @@map("payment")
}

// F-PAY-1: a refund's full lifecycle lives here, decoupled from the payment.
// The application payment stays economically PAID (status SUCCEEDED, allocations
// intact) while an attempt is PENDING; only a provider-confirmed `succeeded`
// flips the payment to REFUNDED and reverses allocations. This is what makes
// async/ambiguous refunds recoverable: the allocation snapshot is persisted
// here BEFORE Stripe is contacted, so a later webhook/reconciliation can always
// reconstruct exactly what to reverse — the payment row no longer needs to have
// destroyed its allocations up front.
//
// - idempotencyKey is deterministic (`refund_<paymentId>`) and @unique, so it
//   both dedupes the Stripe call across HTTP retries AND acts as a one-attempt-
//   per-payment concurrency guard (a racing double-click hits P2002).
// - providerRefundId is @unique so a webhook/reconciliation correlates to the
//   EXACT Stripe refund instead of guessing among a payment intent's refunds.
model RefundAttempt {
  id                 String       @id @default(cuid())
  paymentId          String
  restaurantId       String
  provider           PaymentProvider
  amount             Float
  idempotencyKey     String       @unique
  providerRefundId   String?      @unique
  status             RefundStatus @default(PENDING)
  reason             String?
  allocationSnapshot Json         @default("[]")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  payment            Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status, provider, updatedAt])
  @@map("refund_attempt")
}

model PaymentProviderEvent {
  id           String          @id @default(cuid())
  provider     PaymentProvider
  eventKey     String
  paymentId    String?
  restaurantId String?
  payload      Json?
  createdAt    DateTime        @default(now())

  payment    Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@unique([provider, eventKey])
  @@index([paymentId])
  @@index([restaurantId, createdAt])
  @@map("payment_provider_event")
}

model DailyTarget {
  id           String     @id @default(cuid())
  restaurantId String
  targetDate   DateTime
  dailyRevenue Float      @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, targetDate])
  @@map("daily_target")
}

// ── Reservations (Phase 1) ────────────────────────────────────────────────
// Reservation *requests*, deliberately decoupled from TableSession/table status.
// A reservation never opens a session and never marks a table occupied.

model ReservationSettings {
  id                     String     @id @default(cuid())
  restaurantId           String     @unique
  enabled                Boolean    @default(false)
  slotIntervalMinutes    Int        @default(30)
  minLeadMinutes         Int        @default(60)
  bookingHorizonDays     Int        @default(60)
  maxTotalGuests         Int        @default(12)
  maxCoversPerSlot       Int?
  autoConfirm            Boolean    @default(false)
  requirePhone           Boolean    @default(true)
  allergenSectionEnabled Boolean    @default(true)
  // Owner-defined extra preference chips shown on the public booking form
  // (e.g. "Swimming pool", "Terrace", "Kids area"). Non-dietary, no consent.
  customPreferences      String[]   @default([])
  notifyEmail            String?
  notifyPhone            String?
  // Feature 4: dining duration / turnover. Small parties get the base duration;
  // parties at or above the threshold get the longer duration. Used to show
  // staff when a table is expected to free up.
  diningDurationMinutes     Int     @default(90)
  largePartyThreshold       Int     @default(5)
  largePartyDurationMinutes Int     @default(150)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  restaurant             Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("reservation_settings")
}

model ReservationServiceHours {
  id             String     @id @default(cuid())
  restaurantId   String
  weekday        Int // ISO 1..7
  openMinute     Int // minutes from local midnight, 0..1439
  lastSlotMinute Int // last bookable slot start
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, weekday])
  @@map("reservation_service_hours")
}

// Feature 5: owner-declared closed days (holidays, private events). A blackout
// suppresses every slot for that restaurant-local calendar date. Stored as a
// plain YYYY-MM-DD string so it compares directly against the availability
// engine's timezone-derived local date — no UTC-midnight drift.
model ReservationBlackout {
  id           String     @id @default(cuid())
  restaurantId String
  date         String // restaurant-local calendar date, YYYY-MM-DD
  reason       String?
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, date])
  @@index([restaurantId])
  @@map("reservation_blackout")
}

// Minimal patron: cross-visit STAFF-ONLY tags, matched by (restaurantId, phone).
// Holds no dietary/allergy data — that stays per-reservation.
model Patron {
  id           String        @id @default(cuid())
  restaurantId String
  phone        String
  name              String
  email             String?
  staffTags         String[]      @default([])
  staffNotes        String?
  // Durable marketing opt-in for this patron (separate from the transactional
  // reservation). Only opted-in patrons may be targeted with promotions.
  marketingConsent   Boolean      @default(false)
  marketingConsentAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  restaurant        Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reservations      Reservation[]

  @@unique([restaurantId, phone])
  @@index([restaurantId])
  @@map("patron")
}

model Reservation {
  id                  String              @id @default(cuid())
  restaurantId        String
  patronId            String?
  referenceCode       String
  source              ReservationSource   @default(PUBLIC)
  status              ReservationStatus   @default(PENDING)
  guestName           String
  guestPhone          String // normalized E.164
  guestEmail          String?
  startsAt            DateTime // UTC instant of the requested slot
  occasion            ReservationOccasion @default(NONE)
  adultsCount         Int
  childrenCount       Int                 @default(0)
  customerNotes       String?
  internalNotes       String? // STAFF ONLY — never in public responses/sockets
  customerPreferences String[]            @default([])
  allergyNotes        String? // special-category; only stored with consent
  dietaryConsentAt    DateTime?
  marketingConsentAt  DateTime? // set when the guest opts in to promotions
  // Feature 1: guest-chosen notification channels for confirm/cancel/reminder.
  notifyByEmail       Boolean             @default(true)
  notifyBySms         Boolean             @default(false)
  reminderSentAt      DateTime? // set once the 24h reminder has gone out (dedup)
  // Feature 3: guest's preferred seating zone (soft hint). Stored as the zone
  // NAME, not an FK, so a later zone rename/delete never orphans the booking.
  preferredZone       String?
  // Feature 2: unguessable token for the guest's private self-service link
  // (view / modify / cancel without logging in). Null for legacy rows.
  manageToken         String?             @unique
  // Feature 4: snapshot of the expected dining duration at booking time so a
  // later settings change doesn't retroactively move existing table turnovers.
  durationMinutes     Int?
  idempotencyKey      String?
  createdById         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  restaurant          Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  patron              Patron?             @relation(fields: [patronId], references: [id], onDelete: SetNull)
  events              ReservationEvent[]

  @@unique([restaurantId, referenceCode])
  @@unique([restaurantId, idempotencyKey])
  @@index([restaurantId, startsAt])
  @@index([restaurantId, status, startsAt])
  @@index([patronId])
  @@map("reservation")
}

// Append-only audit trail for reservation transitions.
model ReservationEvent {
  id            String      @id @default(cuid())
  reservationId String
  type          String
  actorUserId   String?
  metadata      Json?
  createdAt     DateTime    @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, createdAt])
  @@map("reservation_event")
}

enum TableSessionStatus {
  OPEN
  PAID
  CLOSED_PAID
  CLOSED_NO_PAYMENT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  ABANDONED
  // DEPRECATED (F-PAY-1 v2): the refund lifecycle now lives in RefundAttempt and
  // the payment stays SUCCEEDED until a provider-confirmed `succeeded` flips it
  // straight to REFUNDED. No code writes REFUND_PENDING anymore. The enum value
  // is retained because dropping a Postgres enum value is destructive and no
  // production rows should carry it; do not reintroduce writes to it.
  REFUND_PENDING
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
  NO_SHOW
  ARRIVED
}

enum ReservationSource {
  PUBLIC
  STAFF
}

enum ReservationOccasion {
  NONE
  BIRTHDAY
  ANNIVERSARY
  BUSINESS
  FAMILY
  OTHER
}

enum PaymentProvider {
  STRIPE
  MYPOS
  EPAY
  CASH
  BORICA
}

enum CashPaymentRequestStatus {
  PENDING
  PAID
  CANCELLED
}

enum CashPaymentRequestScope {
  FULL_TABLE
  ORDER_ITEMS
}

enum SubscriptionTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum PrintJobStatus {
  PENDING
  SENT
  PRINTED
  FAILED
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([actorUserId])
  @@map("admin_audit_log")
}

model PlatformSettings {
  id                        String   @id @default("singleton")
  gdprEnabled               Boolean  @default(false)
  cookieBannerEnabled       Boolean  @default(false)
  privacyPolicyEnabled      Boolean  @default(false)
  termsEnabled              Boolean  @default(false)
  cookiePolicyEnabled       Boolean  @default(false)
  erasureEndpointEnabled    Boolean  @default(false)
  dataExportEndpointEnabled Boolean  @default(false)
  retentionCronEnabled      Boolean  @default(false)
  orderPiiRetentionYears    Int      @default(7)
  verificationTokenTtlDays  Int      @default(7)
  cookieBannerText          Json?
  privacyPolicyContent      Json?
  termsContent              Json?
  cookiePolicyContent       Json?
  dataControllerName        String?
  dataControllerEmail       String?
  dataControllerAddress        String?
  announcementBannerEnabled    Boolean @default(false)
  announcementBannerText       String?
  announcementBannerType       String  @default("info")
  updatedAt                    DateTime @updatedAt
  updatedById                  String?

  @@map("platform_settings")
}

model HelpContent {
  id          String   @id @default(uuid())
  section     String // 'landing' | 'dashboard'
  categoryKey String // e.g. 'getting-started', 'menu', 'general'
  itemKey     String // unique key per item within its section+category
  sortOrder   Int      @default(0)
  locale      String // 'en' | 'bg' | 'ro'
  title       String // FAQ question or help section title
  body        String // FAQ answer or help content (plain text or Markdown)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([section, categoryKey, itemKey, locale])
  @@map("help_content")
}

model DataRequest {
  id                String    @id @default(cuid())
  userId            String
  type              String    // ERASURE | EXPORT
  status            String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | REJECTED
  requestedAt       DateTime  @default(now())
  processedAt       DateTime?
  processedByUserId String?
  notes             String?
  downloadUrl       String?
  user              User      @relation("DataRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  processedBy       User?     @relation("DataRequestProcessor", fields: [processedByUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@map("data_request")
}

model ImpersonationSession {
  id           String    @id @default(cuid())
  actorId      String
  targetId     String
  restaurantId String
  exchangeCode String?   @unique
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  usedAt       DateTime?
  revokedAt    DateTime?
  actor        User      @relation("ImpersonationActor", fields: [actorId], references: [id], onDelete: Cascade)
  target       User      @relation("ImpersonationTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([targetId])
  @@index([exchangeCode])
  @@map("impersonation_session")
}
