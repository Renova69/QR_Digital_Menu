generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  password           String
  name               String?
  phone              String?
  pinHash            String?
  pinAttempts        Int               @default(0)
  pinLockedUntil     DateTime?
  isActive           Boolean           @default(true)
  disabledAt         DateTime?
  disabledReason     String?
  role               UserRole         @default(STAFF)
  restaurantId       String?
  onboardingComplete Boolean          @default(false)
  onboardingStep     String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  orders          Order[]
  staffOrders     Order[]      @relation("StaffOrders")
  createdDeviceEnrollmentTokens DeviceEnrollmentToken[]
  loyaltyAccounts LoyaltyAccount[]
  restaurants     Restaurant[]     @relation("OwnedRestaurants")
  staffRestaurant Restaurant?       @relation("StaffRestaurant", fields: [restaurantId], references: [id])
  adminAuditLogs  AdminAuditLog[]

  @@map("app_user")
}

model Restaurant {
  id                        String              @id @default(cuid())
  name                      String
  country                   String              @default("Bulgaria")
  city                      String?
  logoUrl                   String?
  logoThumbnailUrl           String?
  accentColor               String?             @default("#4F46E5")
  googleReviewUrl           String?
  facebookUrl               String?
  instagramUrl               String?
  tiktokUrl                 String?
  websiteUrl                String?
  youtubeUrl                String?
  address                   String?
  contactInfo               String?
  targetLanguages           String[]            @default([])
  dashboardLanguage         String?             @default("en")
  timezone                  String?             @default("UTC")
  ownerId                   String
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  fontBody                  String?             @default("Outfit")
  fontHeading               String?             @default("Playfair Display")
  themeBgColor              String?
  themeCardColor            String?
  themeTextColor            String?
  themeLightBgColor         String?
  themeLightTextColor       String?
  themeLightCardColor       String?
  themeLightAccentColor     String?
  themeDarkBgColor          String?
  themeDarkTextColor        String?
  themeDarkCardColor        String?
  themeDarkAccentColor      String?
  trendingMode              String              @default("AUTO")
  happyHourEnable           Boolean             @default(false)
  happyHourDays             Int[]               @default([1,2,3,4,5,6,7])
  happyHourEndTime          String?
  happyHourMultiplier       Float               @default(2.0)
  happyHourStartTime        String?
  isLoyaltyEnabled          Boolean             @default(true)
  loyaltyExchangeRate       Int                 @default(10)
  loyaltySignupBonus        Int                 @default(50)
  loyaltyRedeemRate         Int                 @default(150)
  loyaltyExpiryReminderDays Int                 @default(15)
  loyaltyGoldMultiplier     Float               @default(1.5)
  loyaltyGoldThreshold      Int                 @default(2000)
  loyaltyPointExpiryDays    Int                 @default(90)
  loyaltySilverMultiplier   Float               @default(1.2)
  loyaltySilverThreshold    Int                 @default(500)
  defaultTheme              String?             @default("light")
  importApiKey              String?             @unique
  stripeAccountId           String?
  stripeOnboarded           Boolean             @default(false)
  paymentsEnabled           Boolean             @default(false)
  notifyAllStaffOnPayment   Boolean             @default(true)
  tipsEnabled               Boolean             @default(false)
  tipOptions                Int[]               @default([2, 4, 5])
  platformFeePercent        Float               @default(0.5)
  tier                      SubscriptionTier    @default(FREE)
  stripeCustomerId          String?
  stripeSubscriptionId      String?
  stripePriceId             String?
  tierUpdatedAt             DateTime?
  forceTier                 SubscriptionTier?
  isActive                  Boolean             @default(true)
  deletedAt                 DateTime?
  assistanceRequests        AssistanceRequest[]
  deviceEnrollmentTokens    DeviceEnrollmentToken[]
  orders                    Order[]
  feedbacks                 Feedback[]
  loyaltyAccounts           LoyaltyAccount[]
  menuCategories            MenuCategory[]
  owner                     User                @relation("OwnedRestaurants", fields: [ownerId], references: [id], onDelete: Cascade)
  staffMembers              User[]              @relation("StaffRestaurant")
  tables                    RestaurantTable[]
  tableSessions             TableSession[]
  tableZones                TableZone[]
  payments                  Payment[]

  @@map("restaurant")
}

model TableZone {
  id           String            @id @default(cuid())
  name         String
  restaurantId String
  displayOrder Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables       RestaurantTable[]

  @@unique([restaurantId, name])
  @@index([restaurantId, displayOrder])
  @@map("table_zone")
}

model RestaurantTable {
  id           String          @id @default(cuid())
  name         String
  restaurantId String
  zoneId       String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  zone         TableZone?      @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  sessions     TableSession[]

  @@index([restaurantId, zoneId])
  @@map("restaurant_table")
}

model MenuCategory {
  id               String           @id @default(cuid())
  name             String
  restaurantId     String
  order            Int
  availabilityType AvailabilityType @default(ALWAYS)
  startTime        String?
  endTime          String?
  daysOfWeek       Int[]
  translations     Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  imageUrl         String?
  thumbnailUrl     String?
  isDrinkCategory  Boolean          @default(false)
  restaurant       Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items            MenuItem[]

  @@map("menu_category")
}

model MenuItem {
  id                String       @id @default(cuid())
  name              String
  description       String?
  price             Float
  weight            String?
  currency          Currency
  allergens         String[]
  dietaryTags       String[]
  imageUrl          String?
  thumbnailUrl      String?
  isOutOfStock      Boolean      @default(false)
  categoryId        String
  order             Int
  translations      Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  isFeatured        Boolean      @default(false)
  relatedItemIds    String[]     @default([])
  rewardPointsPrice Int?
  category          MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options           MenuOption[]
  orderItems        OrderItem[]

  @@index([categoryId, order])
  @@map("menu_item")
}

model MenuOption {
  id           String     @id @default(cuid())
  name         String
  type         OptionType
  choices      Json
  menuItemId   String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  translations Json?
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@map("menu_option")
}

model Order {
  id                        String               @id @default(cuid())
  customerName              String
  customerPhone             String?
  tableId                   String?
  status                    OrderStatus          @default(NEW)
  restaurantId              String
  totalPrice                Float
  specialRequests           String?
  tableSessionId            String?
  tableSession              TableSession?        @relation(fields: [tableSessionId], references: [id])
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  customerId                String?
  pointsEarned              Int                  @default(0)
  pointsRedeemed            Int                  @default(0)
  pointsRedeemedForDiscount Int                  @default(0)
  pointsRedeemedForItems    Int                  @default(0)
  customer                  User?                @relation(fields: [customerId], references: [id])
  restaurant                Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  feedback                  Feedback?
  loyaltyPointTransactions  LoyaltyPointLedger[]
  items                     OrderItem[]
  source                    OrderSource          @default(CUSTOMER)
  staffUserId               String?
  staff                     User?                @relation("StaffOrders", fields: [staffUserId], references: [id])

  @@index([restaurantId, status, createdAt])
  @@map("customer_order")
}

model OrderItem {
  id              String    @id @default(cuid())
  orderId         String
  menuItemId      String?
  quantity        Int
  selectedOptions Json
  menuItem        MenuItem? @relation(fields: [menuItemId], references: [id])
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_item")
}

model AssistanceRequest {
  id           String     @id @default(cuid())
  tableId      String
  isResolved   Boolean    @default(false)
  restaurantId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, isResolved])
  @@map("assistance_request")
}

model DeviceEnrollmentToken {
  id           String     @id @default(cuid())
  tokenHash    String     @unique
  restaurantId String
  createdById  String
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdBy    User       @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([expiresAt])
  @@map("device_enrollment_token")
}

model Feedback {
  id                 String     @id @default(cuid())
  rating             Int
  comment            String?
  redirectedToGoogle Boolean    @default(false)
  orderId            String     @unique
  restaurantId       String
  createdAt          DateTime   @default(now())
  order              Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("feedback")
}

model LoyaltyAccount {
  id             String               @id @default(cuid())
  userId         String
  restaurantId   String
  points         Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  lifetimePoints Int                  @default(0)
  restaurant     Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointLedger    LoyaltyPointLedger[]

  @@unique([userId, restaurantId])
  @@map("loyalty_account")
}

model LoyaltyPointLedger {
  id               String                      @id @default(cuid())
  loyaltyAccountId String
  orderId          String?
  type             LoyaltyPointTransactionType
  points           Int
  remainingPoints  Int                         @default(0)
  expiresAt        DateTime?
  reminderSentAt   DateTime?
  createdAt        DateTime                    @default(now())
  loyaltyAccount   LoyaltyAccount              @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  order            Order?                      @relation(fields: [orderId], references: [id])

  @@index([loyaltyAccountId, expiresAt])
  @@index([expiresAt, reminderSentAt])
  @@map("loyalty_point_ledger")
}

enum UserRole {
  OWNER
  MANAGER
  WAITER
  KITCHEN
  STAFF
  CUSTOMER
  SUPER_ADMIN
}

enum Currency {
  EUR
  BGN
}

enum OrderStatus {
  NEW
  IN_PROGRESS
  SERVED
  CANCELED
  COMPLETED
  PENDING_PAYMENT
}

enum OrderSource {
  CUSTOMER
  POS
}

enum OptionType {
  VARIATION
  ADDON
}

enum AvailabilityType {
  ALWAYS
  SCHEDULED
  HIDDEN
}

enum LoyaltyPointTransactionType {
  EARN
  SIGNUP
  REDEEM
  EXPIRE
  ADJUSTMENT
}

model VerificationToken {
  id         String    @id @default(cuid())
  email      String
  code       String
  expiresAt  DateTime
  usedAt     DateTime?
  attempts   Int       @default(0)
  lockedUntil DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

model TableSession {
  id           String             @id @default(cuid())
  token        String             @unique @default(cuid())
  tableId      String
  restaurantId String
  status       TableSessionStatus @default(OPEN)
  createdAt    DateTime           @default(now())
  paidAt       DateTime?
  orders       Order[]
  payments     Payment[]
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table        RestaurantTable    @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([tableId, status])
  @@index([restaurantId, status])
  @@map("table_session")
}

model Payment {
  id                    String          @id @default(cuid())
  tableSessionId        String
  restaurantId          String
  stripePaymentIntentId String?         @unique
  amount                Float
  tipAmount             Float           @default(0)
  platformFeeAmount     Float           @default(0)
  currency              String          @default("EUR")
  status                PaymentStatus   @default(PENDING)
  provider              PaymentProvider @default(STRIPE)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  tableSession          TableSession    @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  restaurant            Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([tableSessionId])
  @@map("payment")
}

enum TableSessionStatus {
  OPEN
  PAID
  CLOSED_NO_PAYMENT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  MYPOS
  CASH
}

enum SubscriptionTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorUserId], references: [id])

  @@index([targetType, targetId])
  @@index([actorUserId])
  @@map("admin_audit_log")
}

model PlatformSettings {
  id                        String   @id @default("singleton")
  gdprEnabled               Boolean  @default(false)
  cookieBannerEnabled       Boolean  @default(false)
  privacyPolicyEnabled      Boolean  @default(false)
  termsEnabled              Boolean  @default(false)
  cookiePolicyEnabled       Boolean  @default(false)
  erasureEndpointEnabled    Boolean  @default(false)
  dataExportEndpointEnabled Boolean  @default(false)
  retentionCronEnabled      Boolean  @default(false)
  orderPiiRetentionYears    Int      @default(7)
  verificationTokenTtlDays  Int      @default(7)
  cookieBannerText          Json?
  privacyPolicyContent      Json?
  termsContent              Json?
  cookiePolicyContent       Json?
  dataControllerName        String?
  dataControllerEmail       String?
  dataControllerAddress     String?
  updatedAt                 DateTime @updatedAt
  updatedById               String?

  @@map("platform_settings")
}

model HelpContent {
  id          String   @id @default(uuid())
  section     String   // 'landing' | 'dashboard'
  categoryKey String   // e.g. 'getting-started', 'menu', 'general'
  itemKey     String   // unique key per item within its section+category
  sortOrder   Int      @default(0)
  locale      String   // 'en' | 'bg' | 'ro'
  title       String   // FAQ question or help section title
  body        String   // FAQ answer or help content (plain text or Markdown)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([section, categoryKey, itemKey, locale])
  @@map("help_content")
}
