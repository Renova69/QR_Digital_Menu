# Append ?pgbouncer=true&connection_limit=10 for Neon serverless connection pooling
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=10
JWT_SECRET=your-secret-key-here
GOOGLE_CLIENT_ID=your-google-id
GOOGLE_CLIENT_SECRET=your-google-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Twilio SMS for reservation confirmations/reminders (optional — reservations
# dev-log SMS instead of sending when these are unset or NODE_ENV != production)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Configure either a Messaging Service SID (preferred) or a direct From number.
TWILIO_MESSAGING_SERVICE_SID=MG...
TWILIO_FROM_NUMBER=+15551234567
# Twilio Verify service (phone OTP on the customer profile). Separate product
# from the reservation SMS above.
TWILIO_VERIFY_SERVICE_SID=VA...
TWILIO_CHANNEL=sms
#
# ── SIM-based SMS gateway (capcom6 "SMS Gate") — cheaper for the BG market ──
# Set SMS_PROVIDER=smsgateway to route BOTH reservation SMS and phone OTP
# through an Android phone's SIM instead of Twilio. The Twilio vars above are
# kept but unused while this is active — flip SMS_PROVIDER back to switch over.
# SMS_GATEWAY_URL defaults to the hosted cloud API; point it at a self-hosted
# private server (http://<device-ip>:8080/message) if you run your own.
SMS_PROVIDER=twilio
SMS_GATEWAY_URL=https://api.sms-gate.app/3rdparty/v1/message
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
# Reservation SMS is dev-logged (not sent) unless NODE_ENV=production. Set this
# to 'true' to actually deliver reservation SMS in dev for local testing. Phone
# OTP and reservation SMS are both blocked in dev unless this is explicitly
# enabled. Leave unset/false in production.
SMS_FORCE_SEND=false
# Stripe subscription billing (required for /pricing checkout)
# Create 3 products in Stripe Dashboard, each with monthly + yearly recurring prices
# Yearly price = monthly × 12 × 0.85 (15% annual discount)
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_...
STRIPE_PRICE_PROFESSIONAL_YEARLY=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_YEARLY=price_...
# Subscription webhook (Stripe Dashboard → Webhooks → add endpoint /api/v1/subscription/webhook)
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_...
# ── ePay.bg hosted checkout (optional) ──────────────────────────────────────
# EPAY_SECRET_ENCRYPTION_KEY=32-char-random-key   # defaults to JWT_SECRET
# EPAY_DEMO_URL=https://demo.epay.bg/
# EPAY_LIVE_URL=https://www.epay.bg/
# EPAY_EXPIRATION_MINUTES=30

# ── BORICA EMV-3DS direct card payments (optional) ──────────────────────────
# DEMO mode uses the platform sandbox terminal — set these to the bundled test
# keypair from tests/certificates/ (veneliniliev/borica-3ds on GitHub).
# BORICA_TEST_TID=V1800001
# BORICA_TEST_MID=1600000001
# BORICA_TEST_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# BORICA_TEST_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# BORICA_DEV_URL=https://3dsgate-dev.borica.bg/cgi-bin/cgi_link
# BORICA_PROD_URL=https://3dsgate.borica.bg/cgi-bin/cgi_link
# BACKEND_URL=https://your-cloud-run-url   # used to build BACKREF callback URL

# ── Web Push (VAPID) — dashboard order notifications ────────────────────────
# Generate a keypair once with:  npx web-push generate-vapid-keys
# The PUBLIC key must equal the frontend's VITE_PUBLIC_VAPID_KEY. The PRIVATE
# key is a secret (backend only). In production BOTH must be set — the service
# refuses to fall back to ephemeral keys there (they break per restart/instance).
# VAPID_PUBLIC_KEY=BEN9...ryTM
# VAPID_PRIVATE_KEY=<43-char base64url secret>
