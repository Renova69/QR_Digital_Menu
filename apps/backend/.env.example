# Append ?pgbouncer=true&connection_limit=10 for Neon serverless connection pooling
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=10
JWT_SECRET=your-secret-key-here
GOOGLE_CLIENT_ID=your-google-id
GOOGLE_CLIENT_SECRET=your-google-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Stripe subscription billing (required for /pricing checkout)
# Create 3 products in Stripe Dashboard, each with monthly + yearly recurring prices
# Yearly price = monthly × 12 × 0.85 (15% annual discount)
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_...
STRIPE_PRICE_PROFESSIONAL_YEARLY=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_YEARLY=price_...
# Subscription webhook (Stripe Dashboard → Webhooks → add endpoint /api/v1/subscription/webhook)
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_...
# ── ePay.bg hosted checkout (optional) ──────────────────────────────────────
# EPAY_SECRET_ENCRYPTION_KEY=32-char-random-key   # defaults to JWT_SECRET
# EPAY_DEMO_URL=https://demo.epay.bg/
# EPAY_LIVE_URL=https://www.epay.bg/
# EPAY_EXPIRATION_MINUTES=30

# ── BORICA EMV-3DS direct card payments (optional) ──────────────────────────
# DEMO mode uses the platform sandbox terminal — set these to the bundled test
# keypair from tests/certificates/ (veneliniliev/borica-3ds on GitHub).
# BORICA_TEST_TID=V1800001
# BORICA_TEST_MID=1600000001
# BORICA_TEST_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# BORICA_TEST_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# BORICA_DEV_URL=https://3dsgate-dev.borica.bg/cgi-bin/cgi_link
# BORICA_PROD_URL=https://3dsgate.borica.bg/cgi-bin/cgi_link
# BACKEND_URL=https://your-cloud-run-url   # used to build BACKREF callback URL
