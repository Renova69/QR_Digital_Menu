# Frontend (Vite) environment. Copy to .env and fill in.
# VITE_* vars are inlined into the client bundle at BUILD time — never put
# secrets here. Set the same values in Vercel for production builds.

# Backend API origin. Dev: same-origin via the Vite proxy (see vite.config.js).
# Prod (Vercel → Cloud Run): the full cross-origin API base, e.g.
# https://qr-menu-backend-xxxx.run.app/api
VITE_API_URL=http://localhost:3000/api

# Local `npm run dev` waits for this API to become ready before exposing Vite.
# Set to false only when intentionally developing the frontend without a backend.
DEV_WAIT_FOR_BACKEND=true
DEV_BACKEND_WAIT_TIMEOUT_MS=180000

# Stripe publishable key (pk_test_… / pk_live_…). Public by design.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Web Push public VAPID key. MUST equal the backend's VAPID_PUBLIC_KEY.
# Generate the pair with:  npx web-push generate-vapid-keys
VITE_PUBLIC_VAPID_KEY=BEN9...ryTM

# ── Sentry error tracking ────────────────────────────────────────────────────
# Public DSN — safe to embed in the client bundle by design. Error tracking is
# disabled entirely when unset (see src/lib/sentry.ts).
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.<region>.sentry.io/<project>
#
# The following are BUILD-TIME ONLY (read by vite.config.js, never bundled
# into client code) and SENTRY_AUTH_TOKEN is a real org-level secret — set it
# in Vercel's project env vars, never here with a real value.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=qr-menu-frontend
