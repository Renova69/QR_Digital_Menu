{
  "name": "printer-agent",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@supersami/rn-foreground-service": "^2.2.5",
    "expo": "~56.0.9",
    "expo-camera": "~56.0.8",
    "expo-clipboard": "^56.0.4",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-tcp-socket": "^6.4.1",
    "socket.io-client": "^4.8.3"
  },
  "publishConfig": {
    "executableFiles": [
      "./android/gradlew"
    ]
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint \"App.tsx\" \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --runInBand",
    "test:cov": "jest --ci --runInBand --coverage"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/jest": "^29.5.14",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "expo-modules-core": "~56.0.22",
    "globals": "^16.5.0",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.5",
    "typescript-eslint": "^8.65.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/services/**/*.ts",
      "!src/**/*.test.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "branches": 26,
        "functions": 66,
        "lines": 65,
        "statements": 62
      }
    }
  }
}
