# graphify knowledge graph -- generated, not source.
# The post-commit hook rebuilds it after every commit, and graph.json alone is
# ~9 MB, so tracking it meant each commit carried a near-total rewrite of the
# whole directory. Regenerate locally with `graphify update .` (AST-only, no
# API cost); a fresh clone has no graph until that runs.
graphify-out/

# claude-flow daemon state, logs and metrics -- machine-local, always dirty.
.claude-flow/

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Per-run dev server logs (scripts/dev-with-logs.js)
/logs/dev/

# Database backups (contain PII — never commit)
**/backups/

.vercel
.deploy-env.yaml

