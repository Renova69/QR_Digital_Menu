{
  "name": "qr-menu-monorepo",
  "private": true,
  "packageManager": "npm@10.2.4",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "logs:errors": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/logs.ps1 -Kind errors",
    "logs:payments": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/logs.ps1 -Kind payments",
    "logs:client": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/logs.ps1 -Kind client",
    "logs:all": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/logs.ps1 -Kind all",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.4.4"
  },
  "dependencies": {
    "helmet": "^8.1.0"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1"
  }
}
